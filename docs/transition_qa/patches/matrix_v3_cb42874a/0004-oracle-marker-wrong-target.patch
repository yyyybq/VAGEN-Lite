diff --git a/data_gen/interiorgs_v10/self_marker.py b/data_gen/interiorgs_v10/self_marker.py
new file mode 100644
index 00000000..da5ec5c8
--- /dev/null
+++ b/data_gen/interiorgs_v10/self_marker.py
@@ -0,0 +1,70 @@
+"""Self mode of G-oracle's evaluation (the user's instruction of 2026-11-07, item 6c; ``evaluation run --self-marker``):
+before every action the same model is asked to box each target of the task, with Pg's own question ("Draw a box
+around {ref}. ...", data_gen.transition_qa.pointing_qa.QUESTION, 0-1000 coordinates; one user turn with the frame and no
+system prompt, as the pointing probe asks), its boxes are drawn into the frame in the oracle marker's style
+(oracle_marker.draw: A red, B blue), and the action call sees that frame.  An answer without four numbers draws no box
+for its target.  Each turn records the answers, the boxes read, the truth (pointing.truth) and the IoU of each box with
+its target's true box (None when the target has no true box: not clearly visible)."""
+from __future__ import annotations
+
+from typing import Any, Callable, Dict, List, Optional, Sequence, Tuple
+
+FRAME = 256.0
+
+
+def questions(item: Dict[str, Any]) -> List[Tuple[str, str]]:
+    """(letter, question) per object of the task text, A, B in the text's order."""
+    from data_gen.transition_qa.pointing_qa import QUESTION
+    from vagen.envs.active_spatial.pointing import SLOT_LETTERS, target_refs
+
+    return [(l, QUESTION[("box", "norm1000")].format(ref=ref)) for l, ref in zip(SLOT_LETTERS, target_refs(item))]
+
+
+def read_box(text: str) -> Optional[List[float]]:
+    """The box an answer gives, in the 256-frame's pixels (0-1000 coordinates scaled, corners ordered, clipped to the
+    frame); None without four numbers or with an empty box."""
+    from eval.diagnostics.qa_probe import _clean, read_coordinates
+
+    nums, _ = read_coordinates(_clean(text), 4)
+    if len(nums) < 4:
+        return None
+    s = FRAME / 1000.0
+    x1, x2 = sorted((nums[0] * s, nums[2] * s))
+    y1, y2 = sorted((nums[1] * s, nums[3] * s))
+    x1, y1, x2, y2 = (min(max(v, 0.0), FRAME) for v in (x1, y1, x2, y2))
+    return [round(x1, 3), round(y1, 3), round(x2, 3), round(y2, 3)] if x2 > x1 and y2 > y1 else None
+
+
+def iou(a: Sequence[float], b: Sequence[float]) -> float:
+    inter = max(0.0, min(a[2], b[2]) - max(a[0], b[0])) * max(0.0, min(a[3], b[3]) - max(a[1], b[1]))
+    union = (a[2] - a[0]) * (a[3] - a[1]) + (b[2] - b[0]) * (b[3] - b[1]) - inter
+    return inter / union if union > 0 else 0.0
+
+
+def mark_turn(ask: Callable[[str, Any], str], image: Any, item: Dict[str, Any], truth_rows: Sequence[Dict[str, Any]]
+              ) -> Tuple[Any, List[Dict[str, Any]]]:
+    """(the frame with the model's own boxes, per target {letter, answer, box, truth_box, iou})."""
+    from vagen.envs.active_spatial.oracle_marker import draw
+
+    truth = {r["letter"]: r.get("box") for r in truth_rows}
+    marks, rec = [], []
+    for letter, q in questions(item):
+        answer = ask(q, image)
+        box = read_box(answer)
+        tb = truth.get(letter)
+        rec.append({"letter": letter, "answer": answer, "box": box, "truth_box": tb,
+                    "iou": round(iou(box, tb), 4) if (box and tb) else (0.0 if tb else None)})
+        if box:
+            marks.append((letter, box))
+    return draw(image, marks), rec
+
+
+def summary(turns: Sequence[List[Dict[str, Any]]]) -> Dict[str, Any]:
+    """Over an episode's turns: questions, boxes read, the mean IoU and the share with IoU >= 0.5 over the targets with
+    a true box, and the boxes drawn for targets without one."""
+    recs = [r for t in turns for r in t]
+    vis = [r for r in recs if r["truth_box"]]
+    return {"questions": len(recs), "boxes": sum(r["box"] is not None for r in recs), "visible": len(vis),
+            "iou_mean": round(sum(r["iou"] for r in vis) / len(vis), 4) if vis else None,
+            "iou_ge_05": sum(r["iou"] >= 0.5 for r in vis),
+            "boxes_without_truth": sum(r["box"] is not None and not r["truth_box"] for r in recs)}
diff --git a/data_gen/interiorgs_v10/tests/test_self_marker.py b/data_gen/interiorgs_v10/tests/test_self_marker.py
new file mode 100644
index 00000000..314a7284
--- /dev/null
+++ b/data_gen/interiorgs_v10/tests/test_self_marker.py
@@ -0,0 +1,75 @@
+"""data_gen/interiorgs_v10/self_marker.py and the self mode of evaluation.run_episode (the user's item 6c of 2026-11-07)."""
+import unittest
+
+from PIL import Image
+
+from data_gen.interiorgs_v10 import self_marker as SM
+
+ITEM = {"target_object": {"objects": [{"id": "a", "ref": "the lamp", "label": "lamp"},
+                                      {"id": "b", "ref": "the sofa", "label": "sofa"}]}}
+
+
+class SelfMarkerTest(unittest.TestCase):
+    def test_questions_are_pg_box_questions(self):
+        qs = SM.questions(ITEM)
+        self.assertEqual([l for l, _ in qs], ["A", "B"])
+        self.assertTrue(qs[0][1].startswith("Draw a box around the lamp. Answer with the coordinates (x1,y1,x2,y2)"))
+        self.assertIn("0 to 1000", qs[1][1])
+
+    def test_read_box(self):
+        self.assertEqual(SM.read_box("(100,200,300,400)"), [25.6, 51.2, 76.8, 102.4])
+        self.assertEqual(SM.read_box("(300,400,100,200)"), [25.6, 51.2, 76.8, 102.4])  # corners ordered
+        self.assertEqual(SM.read_box("(0,0,1200,500)"), [0.0, 0.0, 256.0, 128.0])  # clipped to the frame
+        self.assertIsNone(SM.read_box("none"))
+        self.assertIsNone(SM.read_box("(10,10,10,50)"))  # empty
+
+    def test_mark_turn(self):
+        img = Image.new("RGB", (256, 256), (128, 128, 128))
+        answers = {"lamp": "(100,200,300,400)", "sofa": "I cannot see it"}
+        ask = lambda q, im: next(v for k, v in answers.items() if k in q)  # noqa: E731
+        truth = [{"letter": "A", "in_view": True, "box": [25.6, 51.2, 76.8, 102.4]},
+                 {"letter": "B", "in_view": False, "box": None}]
+        shown, rec = SM.mark_turn(ask, img, ITEM, truth)
+        self.assertEqual([r["iou"] for r in rec], [1.0, None])
+        self.assertEqual(shown.getpixel((26, 80)), (230, 30, 40))  # A's box drawn
+        self.assertEqual(img.getpixel((26, 80)), (128, 128, 128))
+        s = SM.summary([rec])
+        self.assertEqual((s["questions"], s["boxes"], s["visible"], s["iou_ge_05"], s["boxes_without_truth"]), (2, 1, 1, 1, 0))
+
+    def test_run_episode_shows_the_marked_frame(self):
+        from data_gen.interiorgs_v10 import evaluation as EV
+
+        frame = Image.new("RGB", (256, 256), (0, 0, 0))
+
+        class Env:
+            current_item = {"task_id": "t", "task_type": "x", "difficulty": {"d_star": 1}}
+            _current_step = 1
+
+            def reset(self, seed):
+                return {"obs_str": "<image>", "multi_modal_data": {"<image>": [frame]}}, {}
+
+            def system_prompt(self):
+                return "s"
+
+            def step(self, text):
+                return {"obs_str": "<image>", "multi_modal_data": {"<image>": [frame]}}, 0.0, True, {"actions": ["move_forward"]}
+
+            def _calculate_canonical_metric(self):
+                return {"success": False, "gates": {"distance": False}}
+
+        seen = []
+
+        class Policy:
+            def generate(self, system, user, image, **kw):
+                seen.append(image.getpixel((0, 0)))
+                return "<action>move_forward|</action>"
+
+        marked = Image.new("RGB", (256, 256), (9, 9, 9))
+        row = EV.run_episode(Env(), Policy(), 0, 3, self_marker=lambda f, item, env: (marked, [
+            {"letter": "A", "answer": "x", "box": None, "truth_box": None, "iou": None}]))
+        self.assertEqual(seen, [(9, 9, 9)])
+        self.assertEqual(row["self_marker"]["questions"], 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
