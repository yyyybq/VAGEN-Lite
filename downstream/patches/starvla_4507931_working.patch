diff --git a/examples/simBenchmarks/Robocasa_365/train_files/run_robocasa365_navigatekitchen.sh b/examples/simBenchmarks/Robocasa_365/train_files/run_robocasa365_navigatekitchen.sh
new file mode 100755
index 0000000..e03bd4e
--- /dev/null
+++ b/examples/simBenchmarks/Robocasa_365/train_files/run_robocasa365_navigatekitchen.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# RoboCasa365 PandaOmron — NavigateKitchen (pretrain/human LeRobot v2.1).
+# Run from the StarVLA repo root inside the `starVLA` conda env.
+#
+# Local layout expected under ${DATA_ROOT}:
+#   v1.0/pretrain/atomic/NavigateKitchen/20250821/lerobot/{data,videos,meta}
+set -euo pipefail
+
+if [[ "${CONDA_DEFAULT_ENV:-}" != "starVLA" ]]; then
+  source "$(conda info --base)/etc/profile.d/conda.sh"
+  conda activate starVLA
+fi
+
+NUM_GPUS=${NUM_GPUS:-$(python -c "import torch;print(torch.cuda.device_count())")}
+
+TASK=NavigateKitchen
+BATCH=${BATCH:-8}
+MAX_STEPS=${MAX_STEPS:-100000}
+SAVE_EVERY=${SAVE_EVERY:-10000}
+EVAL_EVERY=${EVAL_EVERY:-1000}
+LOG_EVERY=${LOG_EVERY:-100}
+DATA_ROOT=${DATA_ROOT:-./playground/Datasets/robocasa365}
+DATA_MIX=${DATA_MIX:-robocasa365_navigate_kitchen_pretrain_human}
+
+run_root_dir=${RUN_ROOT_DIR:-./playground/Checkpoints}
+run_id=${RUN_ID:-robocasa365_qwenoft_${TASK}}
+output_dir=${run_root_dir}/${run_id}
+mkdir -p "${output_dir}"
+cp "$0" "${output_dir}/"
+
+accelerate launch \
+  --config_file starVLA/config/deepseeds/deepspeed_zero2.yaml \
+  --num_processes "${NUM_GPUS}" \
+  starVLA/training/train_starvla.py \
+  --config_yaml ./examples/simBenchmarks/Robocasa_365/train_files/starvla_qwenoft_navigatekitchen.yaml \
+  --datasets.vla_data.data_root_dir "${DATA_ROOT}" \
+  --datasets.vla_data.data_mix "${DATA_MIX}" \
+  --datasets.vla_data.per_device_batch_size "${BATCH}" \
+  --framework.action_model.action_dim 12 \
+  --framework.action_model.state_dim 16 \
+  --trainer.max_train_steps "${MAX_STEPS}" \
+  --trainer.save_interval "${SAVE_EVERY}" \
+  --trainer.logging_frequency "${LOG_EVERY}" \
+  --trainer.eval_interval "${EVAL_EVERY}" \
+  --run_root_dir "${run_root_dir}" \
+  --run_id "${run_id}" \
+  --wandb_project starVLA_robocasa365
diff --git a/examples/simBenchmarks/Robocasa_365/train_files/starvla_qwenoft_navigatekitchen.yaml b/examples/simBenchmarks/Robocasa_365/train_files/starvla_qwenoft_navigatekitchen.yaml
new file mode 100644
index 0000000..fb3ced5
--- /dev/null
+++ b/examples/simBenchmarks/Robocasa_365/train_files/starvla_qwenoft_navigatekitchen.yaml
@@ -0,0 +1,69 @@
+run_id: starvla_qwenoft_robocasa365_NavigateKitchen
+run_root_dir: playground/Checkpoints
+seed: 42
+wandb_entity: your_wandb_entity
+wandb_project: starVLA_robocasa365
+is_debug: false
+version_id: "0.21"
+
+# QwenOFT: Qwen3-VL-4B backbone + MLP regression action head (L1).
+# action_dim=12 is PandaOmron gym / StarVLA concat order, NOT the packed
+# LeRobot parquet order. Named keys in PandaOmronRoboCasa365DataConfig
+# reassemble modality.json slices:
+#   eef_pos(3) + eef_rot(3) + gripper_close(1) + base_motion(4) + control_mode(1)
+framework:
+  name: QwenOFT
+  qwenvl:
+    base_vlm: /mnt/umm/users/yinbaiqiao/VAGEN-Lite/third_party/starVLA/playground/Pretrained_models/Qwen3-VL-4B-Instruct-Action
+    attn_implementation: flash_attention_2
+  action_model:
+    action_model_type: MLP
+    action_dim: 12
+    state_dim: 16
+    action_horizon: 16
+    future_action_window_size: 15
+    past_action_window_size: 0
+
+datasets:
+  vla_data:
+    dataset_py: lerobot_datasets
+    include_state: false
+    # Override from the VAGEN-Lite launcher. Relative paths in the mixture
+    # are v1.0/pretrain/atomic/NavigateKitchen/20250821/lerobot
+    data_root_dir: /mnt/umm/users/yinbaiqiao/VAGEN-Lite/playground/Datasets/robocasa365
+    data_mix: robocasa365_navigate_kitchen_pretrain_human
+    action_type: delta_ee
+    sequential_step_sampling: false
+    per_device_batch_size: 4
+    load_all_data_for_training: true
+    obs_image_size: [224, 224]
+    delete_pause_frame: false
+    video_backend: torchvision_av
+
+trainer:
+  max_train_steps: 100
+  num_warmup_steps: 10
+  save_interval: 100
+  eval_interval: 1000
+  learning_rate:
+    base: 2.5e-05
+    qwen_vl_interface: 1.0e-05
+    action_model: 1.0e-04
+  lr_scheduler_type: cosine_with_min_lr
+  scheduler_specific_kwargs:
+    min_lr: 1.0e-06
+  freeze_modules: ''
+  loss_scale:
+    vla: 1.0
+    vlm: 0.1
+  max_grad_norm: 1.0
+  weight_decay: 0.0
+  logging_frequency: 5
+  gradient_clipping: 1.0
+  gradient_accumulation_steps: 1
+
+  optimizer:
+    name: AdamW
+    betas: [0.9, 0.95]
+    eps: 1.0e-08
+    weight_decay: 1.0e-08
